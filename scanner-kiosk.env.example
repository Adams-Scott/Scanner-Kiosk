# Scanner Kiosk settings.
# install.sh copies this to /etc/scanner-kiosk.env (readable by root only).
# Edit that copy:              sudo nano /etc/scanner-kiosk.env
# Then apply the change:       sudo systemctl restart scanner-kiosk

# Paperless-ngx address, without a trailing slash, e.g. https://paperless.example.com
PAPERLESS_URL=

# API token of a user allowed to add documents
# (Paperless > your user menu > My Profile > API Auth Token)
PAPERLESS_TOKEN=
