# Copy to /etc/scanner-kiosk.env, fill in, then: sudo chmod 600 /etc/scanner-kiosk.env
# Papra address, without a trailing slash
PAPRA_URL=https://papra.example.com
# Organization ID: the part after /organizations/ in Papra's address bar
PAPRA_ORG_ID=
# API key (Papra > Settings > API keys) with the documents:create permission
PAPRA_API_KEY=

# Optional
#KIOSK_PORT=8080
#KIOSK_DATA=/home/scott/scanner-kiosk-data
