# Scanner Kiosk settings.
# install.sh copies this to /etc/scanner-kiosk.env (readable by root only).
# Edit that copy:              sudo nano /etc/scanner-kiosk.env
# Then apply the change:       sudo systemctl restart scanner-kiosk

# Papra address, without a trailing slash, e.g. https://papra.example.com
PAPRA_URL=

# Organization ID: the part after /organizations/ in Papra's address bar
PAPRA_ORG_ID=

# API key with the documents:create permission (Papra > Settings > API keys)
PAPRA_API_KEY=
